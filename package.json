{
  "name": "ambulance",
  "version": "1.0.0",
  "private": true,
  "description": "EMAS Assistance full-stack website",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "vercel-build": "npm install --prefix client && npm install --prefix server && npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
